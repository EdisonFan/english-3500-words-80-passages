  "defs": [
    {
      "pos": "adj.",
      "meaning": "（移动，运行）低速的，缓慢的；慢速的，低速的；耗时的，太慢的；迟缓的，慢吞吞的；（钟表）慢的；迟钝的，愚笨的；（胶片）曝光慢的；（镜头）小孔径的；（生意）清淡的，不景气的；不曲折的，乏味的，无趣的；（火，烤箱）小火的，弱火的；（球场或地面）软的，阻球的，奔跑困难的"
    },
    {
      "pos": "v.",
      "meaning": "（使）放慢速度，（使）减速；（使）降低，（使）减少；（生活，工作）放松"
    },
    {
      "pos": "adv.",
      "meaning": "低速地，缓慢地"
    },
