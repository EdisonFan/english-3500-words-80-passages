  "defs": [
    {
      "pos": "aux.",
      "meaning": "将要，将会（同I和we连用，表示将来）； ……好吗？要不要……？（用于主动提供帮助、建议或询问意见）；必须，一定（表示决心、命令或指示）；可以（与“you”连用，用以告知某人能做某事或拥有想要的东西）；应，必须（用于法律、规则）；应该，就会（表示可能的结果或后果）；（用于 look forward to 和 hope 之类的动词前表示语气的委婉）"
    }
  ],
  "forms": [],
  "examples": [
    {
      "en": "Where shall we eat tonight?",
      "zh": "我们今晚在哪儿吃饭？"
    },
    {
      "en": "Shall we go blackberrying ?",
      "zh": "我们去采黑莓好不好？"
    },
    {
      "en": "Shall I run you home?",
      "zh": "我开车送你回家好吗？"
    }
  ],
  "synonyms": [
    {
      "pos": "aux.",
      "meaning": "应；会；将；必须",
