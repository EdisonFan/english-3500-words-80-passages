  "defs": [
    {
      "pos": "adj.",
      "meaning": "（表面）粗糙的，不平的；（网球或软式墙网球拍）粗面的；粗暴的，猛烈的；（地方）多暴力的，犯罪盛行的；汹涌的，风浪很大的；粗制的，不完善的；粗俗的，不讲究的；粗略的，大致的；<非正式> 艰难的，不愉快的；<英，非正式> 身体不适的；（声音）粗哑的，不悦耳的；（酒）涩味的；未经加工的；（文具）用以打草稿的"
    },
    {
      "pos": "n.",
      "meaning": "（高尔夫球场的）深草区（the rough）；草稿，草图；<旧，非正式> 粗野的人，暴徒；未加工的宝石；高低不平的地面；粗糙的部分；艰苦，不愉快"
    },
    {
      "pos": "v.",
      "meaning": "粗制，对……粗加工；草拟，画……的轮廓；使不平，把……弄毛糙；<非正式> 因陋就简地生活；粗暴地对待；（在美式橄榄球、冰球等比赛中对对手）动粗"
    },
    {
      "pos": "adv.",
      "meaning": "<非正式> 粗糙地，粗暴地；<英> 风餐露宿"
    },
    {
      "pos": "",
      "meaning": "【名】 （Rough）（英）拉夫（人名）"
    }
  ],
