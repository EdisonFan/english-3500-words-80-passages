    {
      "pos": "v.",
      "meaning": "想知道，好奇，琢磨；不知是否（用于提问或礼貌地提出请求）；感到疑惑，（对…）感到不安；感到惊讶，觉得惊奇"
    },
    {
      "pos": "n.",
      "meaning": "惊讶，惊叹；奇观，奇迹；令人惊讶的事物，令人难以置信的事物；能人，奇才，有特效的东西"
    },
    {
      "pos": "adj.",
      "meaning": "极好的，灵验的"
    },
    {
      "pos": "",
      "meaning": "【名】 （Wonder）（美）旺德（人名）"
    }
  ],
  "forms": [],
  "examples": [
    {
      "en": "I wonder if you can help me.",
